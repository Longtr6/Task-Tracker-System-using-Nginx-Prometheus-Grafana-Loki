# ==========================================
# FILE MẪU CẤU HÌNH MÔI TRƯỜNG (.env.example)
# Hãy copy file này thành .env và điền thông tin thực tế của bạn
# ==========================================

# Database PostgreSQL
POSTGRES_USER=task_admin[cite: 8]
POSTGRES_PASSWORD=YourSecurePassword123[cite: 8]
POSTGRES_DB=task_tracker_db[cite: 8]

# pgAdmin Login
PGADMIN_DEFAULT_EMAIL=admin@tasktracker.com[cite: 8]
PGADMIN_DEFAULT_PASSWORD=YourPgAdminPassword123[cite: 8]

# FastAPI Backend & JWT Security
PROJECT_NAME="Task Tracker API"[cite: 8]
ENVIRONMENT="production"
DEBUG=False
SECRET_KEY=generate_your_secure_random_key_here_using_python[cite: 8]
ALGORITHM=HS256[cite: 8]
ACCESS_TOKEN_EXPIRE_MINUTES=120[cite: 8]
CORS_ORIGINS=https://localhost,https://yourdomain.com

# --- BỔ SUNG: Cấu hình Bảo mật & Giám sát (Monitoring & Hardening) ---
# Mật khẩu quản trị Grafana
GF_SECURITY_ADMIN_PASSWORD=YourSecureGrafanaPassword123

# Tài khoản/Mật khẩu xác thực cho Prometheus (nếu bật Basic Auth)
PROMETHEUS_AUTH_USER=prometheus_admin
PROMETHEUS_AUTH_PASS=YourSecurePrometheusPassword123

# Gmail SMTP (Tùy chọn cho tính năng quên mật khẩu)
MAIL_USERNAME=your_email@ictu.edu.vn[cite: 8]
MAIL_PASSWORD=your_app_password[cite: 8]
MAIL_FROM=your_email@ictu.edu.vn[cite: 8]
MAIL_PORT=587[cite: 8]
MAIL_SERVER=smtp.gmail.com[cite: 8]
MAIL_STARTTLS=True[cite: 8]
MAIL_SSL_TLS=False[cite: 8]