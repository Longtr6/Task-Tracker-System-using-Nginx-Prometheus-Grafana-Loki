# ==========================================
# FILE MẪU CẤU HÌNH MÔI TRƯỜNG (.env.example)
# Hãy copy file này thành .env và điền thông tin thực tế của bạn
# ==========================================

# Database PostgreSQL
POSTGRES_USER=task_admin
POSTGRES_PASSWORD=YourSecurePassword123
POSTGRES_DB=task_tracker_db

# pgAdmin Login
PGADMIN_DEFAULT_EMAIL=admin@tasktracker.com
PGADMIN_DEFAULT_PASSWORD=YourPgAdminPassword123

# FastAPI Backend & JWT Security
PROJECT_NAME="Task Tracker API"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY=generate_your_secure_random_key_here_using_python
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gmail SMTP (Tùy chọn cho tính năng quên mật khẩu)
MAIL_USERNAME=your_email@ictu.edu.vn
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@ictu.edu.vn
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False