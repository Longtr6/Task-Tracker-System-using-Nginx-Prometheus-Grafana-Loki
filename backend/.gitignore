# ==========================================
# 1. File chứa thông tin bảo mật (BẮT BUỘC BỎ QUA)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# 2. Virtual Environment (Môi trường ảo Python)
# ==========================================
venv/
.venv/
env/
ENV/

# ==========================================
# 3. Python Cache & Bytecode (File rác sinh ra khi chạy Python)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# 4. Cấu hình trình soạn thảo (VS Code, PyCharm...)
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 5. Alembic & Database tạm / Log
# ==========================================
alembic/versions/__pycache__/
*.sqlite3
*.db
*.log

# ==========================================
# 6. Docker & OS Files
# ==========================================
.DS_Store
Thumbs.db